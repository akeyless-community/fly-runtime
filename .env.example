# Bootstrap Akeyless auth (read-only access to /fly/...)
AKEYLESS_ACCESS_ID=p-xxxxx
AKEYLESS_ACCESS_KEY=your-access-key
AKEYLESS_GATEWAY_URL=https://api.akeyless.io

# Optional — derived from FLY_* when omitted on Fly.io
AKEYLESS_SECRET_PREFIX=/fly/my-app/development

# Optional — append process group to prefix for multi-process apps
# AKEYLESS_INCLUDE_PROCESS_GROUP_IN_PREFIX=true

# Local simulation of Fly.io metadata
FLY_APP_NAME=my-app
FLY_ENV=development
FLY_PROCESS_GROUP=app
FLY_REGION=iad
